#include <stdio.h>

int height(int n) {
    if (n <= 1)
        return 0;

    return 1 + height(n / 2);
}

int main() {
    int N;
    scanf("%d", &N);

    int a[N];

    for (int i = 0; i < N; i++)
        scanf("%d", &a[i]);

    printf("Height of the binary tree: %d", height(N));

    return 0;
}